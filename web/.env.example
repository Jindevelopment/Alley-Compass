# ─────────────────────────────────────────────────────────────
# 프론트엔드 환경변수. 이 파일을 .env.local 로 복사해 값을 채운다.
#
# ⚠️ VITE_ 로 시작하는 값은 전부 번들에 그대로 들어가 공개된다.
#    서버 전용 키(SUPABASE_SECRET_KEY, ANTHROPIC_API_KEY 등)는 절대 넣지 않는다.
#    그 키들은 alley_compass_etl/.env 에만 두고 backend 가 쓴다.
# ─────────────────────────────────────────────────────────────

# backend/ FastAPI 주소.
# 로컬 개발 기본값이 코드에 있어 이 값이 없어도 http://localhost:8000 으로 동작한다.
VITE_API_BASE_URL=http://localhost:8000


# ── Supabase Auth (로그인) ───────────────────────────────────
# 대시보드 → Settings → API

# 프로젝트 URL. alley_compass_etl/.env 의 SUPABASE_URL 과 같은 값이다.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# 공개용 키. 신형 프로젝트는 sb_publishable_… , 구형은 eyJ… (anon key) 형태다.
# 공개돼도 되는 값이고, 실제 접근 통제는 Postgres RLS 가 한다.
# ⚠️ secret key(sb_secret_…) 를 여기 넣지 않는다. 넣으면 DB 전체가 열린다.
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY


# ── 소셜 로그인 (선택) ───────────────────────────────────────
# Supabase 대시보드(Authentication → Providers)에서 실제로 켠 것만 적는다.
# 켜지 않은 provider 버튼을 보여주면 눌렀을 때 실패한다.
# 비워 두면 이메일 로그인만 뜬다. 예: google,kakao
VITE_AUTH_PROVIDERS=


# ── 카카오맵 (지도, 선택) ─────────────────────────────────────
# 카카오 개발자 콘솔(https://developers.kakao.com) → 내 애플리케이션 →
# 앱 키의 "JavaScript" 키. 로그인에 쓰는 REST API 키와는 다른 키다.
# 도메인 제한으로 보호되는 키라 공개돼도 된다 — 콘솔의 플랫폼 → Web에
# 이 앱을 띄우는 실제 도메인(로컬 localhost:5173, 배포 주소)이 등록돼
# 있어야 그 도메인에서만 동작한다. 비워 두면 지도 카드에 안내 문구만 뜬다.
VITE_KAKAO_MAP_APPKEY=
