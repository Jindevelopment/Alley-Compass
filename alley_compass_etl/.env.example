# ─────────────────────────────────────────────────────────────
# 서버 전용 환경변수. ETL · backend/ FastAPI 가 읽는다.
# 이 파일을 .env 로 복사해 값을 채운다. .env 는 커밋되지 않는다.
# ─────────────────────────────────────────────────────────────

# 서울 열린데이터광장 Open API 인증키
# https://data.seoul.go.kr 에서 발급
SEOUL_API_KEY=YOUR_SEOUL_OPEN_API_KEY


# ── Supabase ─────────────────────────────────────────────────

# 프로젝트 URL. 비밀값이 아니다 — 프론트엔드도 같은 값을 쓴다.
# Supabase 대시보드 → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# 서버 전용 키. RLS 를 우회하므로 노출되면 DB 전체가 열린다.
# 신형 프로젝트는 sb_secret_… 형태다.
# ⚠️ React/Vite 프론트엔드에 절대 넣지 않는다. 번들에 그대로 들어간다.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# (선택) 구형 프로젝트에서 service_role key 를 쓰는 경우
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# (조건부) 로그인 토큰 검증용 — 토큰이 HS256(구형)으로 서명될 때만 필요하다.
#
# backend/auth.py 는 토큰 헤더의 서명 방식을 보고 검증 경로를 고른다.
#   ES256/RS256(비대칭) → SUPABASE_URL 의 JWKS 공개키로 검증. 이 값이 필요 없다.
#   HS256(대칭, 구형)   → 아래 값이 있어야 검증할 수 있다.
#
# 내 프로젝트가 어느 쪽인지: 대시보드 → Project Settings → JWT Keys 에서
# "Current key" 의 종류를 본다. JWKS(jwks.json)에 키가 보여도 그게 standby
# 키일 수 있어서 판별 기준이 되지 못한다.
# HS256 이면 같은 화면의 Legacy JWT Secret 을 넣거나, 비대칭 키로 rotate 한다.
# 필요한데 없으면 로그인 직후 화면에 이 안내가 그대로 뜬다.
# SUPABASE_JWT_SECRET=YOUR_JWT_SECRET


# ── Claude ───────────────────────────────────────────────────

# Recommendation / Risk / Verification Agent 용
# (narrative_agents.py, pipeline.py, backend 의 /agents 엔드포인트)
# console.anthropic.com 에서 발급. Claude Code 로그인과는 별개다.
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY


# ── backend/ FastAPI ─────────────────────────────────────────

# 데이터 출처. false 면 alley_compass_etl 이 만든 로컬 CSV 를 읽는다.
# BACKEND_USE_SUPABASE=false

# 브라우저에서 API 를 부를 수 있는 출처. 쉼표로 구분한다.
# 로그인 이후로는 Authorization 헤더가 오가므로 "*" 를 쓰지 않는다.
# 비워 두면 로컬 개발용 http://localhost:5173 하나만 허용한다.
# 배포 서버에는 반드시 실제 웹 주소를 적는다. 로컬에서도 같이 쓰려면 둘 다 적는다.
#   예: CORS_ORIGINS=https://your-domain.com,http://localhost:5173
# CORS_ORIGINS=https://your-domain.com

# 사용자별 Claude 호출 한도(1시간 기준, backend/ratelimit.py). 로그인만 하면
# 통과하던 /parse-condition·/agents·/report 를 과도한 반복 호출로부터 보호한다.
# 비워 두면 기본값(파싱 60·근거생성+리포트 40)을 쓴다.
# PARSE_CREDIT_LIMIT_PER_HOUR=60
# AGENT_CREDIT_LIMIT_PER_HOUR=40

# 업종별 district_features 메모리 캐시(backend/main.py get_business_frame())를 몇 초마다
# 다시 읽을지(초 단위). 비워 두면 기본 21600(6시간)을 쓴다. alley_compass_etl.py로
# 새 분기를 올려도 이 시간이 지나야 화면에 반영된다.
# FRAME_CACHE_TTL_SECONDS=21600
